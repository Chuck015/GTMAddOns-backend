{
  "version": 2,
  "switches": {
    "probes": true,
    "combo_stats": true,
    "click_stats": true,
    "aim_stats": true,
    "move_states": true
  },
  "values": {
    "melee_range": 10
  },
  "patterns": {},
  "probes": [
    {"id":"cd_clear","about":"Time from your melee hit to the server clearing that weapon's cooldown","op":"between","event":"melee_hit","end":"cooldown","end_where":{"ticks":0},"same":["group"],"within_ms":1500},
    {"id":"lock_left","about":"Time left in each Combo'd message","op":"value","event":"combo_msg","field":"left_ms"},
    {"id":"melee_dist","about":"Distance of your melee hits","op":"value","event":"melee_hit","field":"dist"},
    {"id":"melee_gap","about":"Time between your melee hits (under 2 s)","op":"value","event":"melee_hit","field":"gap_ms","where":{"gap_ms":{"max":2000}}},
    {"id":"taken_by_move","about":"Player hits on you, by how you were moving","op":"by","event":"damage","field":"move","where":{"to_me":true,"cause_player":true}},
    {"id":"shots_by_move","about":"Your gun shots, by how you were moving","op":"by","event":"shot_result","field":"move"},
    {"id":"hits_by_move","about":"Your gun hits, by how you were moving","op":"by","event":"shot_result","field":"move","where":{"hit":true}},
    {"enabled":false,"id":"hitback_ms","about":"Time from a melee hit on you to your next melee hit","op":"between","event":"melee_hit_me","end":"melee_hit","within_ms":2000},
    {"enabled":false,"id":"melee_weapon","about":"Your melee hits, by weapon","op":"by","event":"melee_hit","field":"item"},
    {"enabled":false,"id":"hit_by_weapon","about":"Melee hits on you, by the attacker's weapon","op":"by","event":"melee_hit_me","field":"item"},
    {"enabled":false,"id":"taken_melee_dist","about":"Distance of melee hits on you","op":"value","event":"melee_hit_me","field":"dist"},
    {"enabled":false,"id":"lock_blanks","about":"Blank swings while combo'd (each Combo'd message)","op":"count","event":"combo_msg"},
    {"enabled":false,"id":"shots_dist","about":"Your gun shots by distance (blocks; misses may have no distance)","op":"bucket","event":"shot_result","field":"dist","edges":[5,15,30,60]},
    {"enabled":false,"id":"hits_dist","about":"Your gun hits by distance","op":"bucket","event":"shot_result","field":"dist","edges":[5,15,30,60],"where":{"hit":true}},
    {"enabled":false,"id":"hs_dist","about":"Your headshots by distance","op":"bucket","event":"shot_result","field":"dist","edges":[5,15,30,60],"where":{"headshot":true}},
    {"enabled":false,"id":"kill_shot_dist","about":"Distance of your killing shots","op":"value","event":"shot_result","field":"dist","where":{"kill":true}},
    {"enabled":false,"id":"return_fire_ms","about":"Time from a player hitting you to your next shot","op":"between","event":"damage","where":{"to_me":true,"cause_player":true},"end":"shot","within_ms":3000},
    {"enabled":false,"id":"shot_gap_ms","about":"Time between two shots of the same gun","op":"between","event":"shot","end":"shot","same":["gun"],"within_ms":2000},
    {"enabled":false,"id":"hs_by_move","about":"Your headshots, by how you were moving","op":"by","event":"shot_result","field":"move","where":{"headshot":true}},
    {"enabled":false,"id":"taken_by_type","about":"Damage taken, by damage type","op":"by","event":"damage","field":"type","where":{"to_me":true}},
    {"enabled":false,"id":"dealt_by_type","about":"Damage dealt, by damage type","op":"by","event":"damage","field":"type","where":{"by_me":true}},
    {"enabled":false,"id":"explosive_taken","about":"Explosion hits on you","op":"count","event":"damage","where":{"to_me":true,"type":{"re":"explo"}}},
    {"enabled":false,"id":"target_hp_at_hit","about":"Your target's health when your hits land","op":"value","event":"damage","field":"target_hp","where":{"by_me":true,"target_player":true}},
    {"enabled":false,"id":"item_use","about":"Items you used, by cooldown group","op":"by","event":"cooldown","field":"group","where":{"ticks":{"min":1}}},
    {"enabled":false,"id":"swap_after_hit_ms","about":"Time from a player hitting you to your next swap","op":"between","event":"damage","where":{"to_me":true,"cause_player":true},"end":"swap","within_ms":5000},
    {"enabled":false,"id":"swap_to_shot_ms","about":"Time from a successful swap to your next shot","op":"between","event":"swap","where":{"result":"SUCCESS"},"end":"shot","within_ms":3000},
    {"enabled":false,"id":"boost_presses","about":"Shift presses while gliding (boost attempts)","op":"count","event":"boost_press"},
    {"enabled":false,"id":"boost_ok_ms","about":"Boost attempts that boosted, and the delay to the boost","op":"between","event":"boost_press","end":"boost","within_ms":1000},
    {"enabled":false,"id":"boost_pitch","about":"Boosts by look angle (negative = up)","op":"bucket","event":"boost","field":"pitch","edges":[-60,-40,-20,0]},
    {"enabled":false,"id":"jetpack_starts","about":"Jetpack starts that flew / failed","op":"by","event":"jetpack_start","field":"ok"},
    {"enabled":false,"id":"jetpack_tap_gap","about":"Time between the two jump taps of a jetpack start","op":"value","event":"jetpack_tap","field":"gap_ms"},
    {"enabled":false,"id":"hp_at_kill","about":"Your health when you got a kill","op":"value","event":"fight_end","field":"hp","where":{"outcome":"KILL"}},
    {"enabled":false,"id":"hp_lost","about":"Health lost per drop (sum = total damage taken)","op":"value","event":"health","field":"change","where":{"change":{"max":-0.01}}},
    {"enabled":false,"id":"hp_healed","about":"Health gained per rise (sum = total healed)","op":"value","event":"health","field":"change","where":{"change":{"min":0.01}}},
    {"enabled":false,"id":"switches","about":"Hotbar switches","op":"count","event":"hotbar"},
    {"enabled":false,"id":"switch_gap_ms","about":"Time between hotbar switches (under 5 s)","op":"value","event":"hotbar","field":"ms","where":{"ms":{"max":5000}}},
    {"enabled":false,"id":"melee_to_shot_ms","about":"Time from a melee hit to your next shot","op":"between","event":"melee_hit","end":"shot","within_ms":3000},
    {"enabled":false,"id":"wtap_ms","about":"Sprint stop to sprint start under 0.5 s (W-taps / sprint resets)","op":"between","event":"sprint","where":{"on":false},"end":"sprint","end_where":{"on":true},"within_ms":500},
    {"enabled":false,"id":"reset_after_hit","about":"Melee hits followed by a sprint stop within 0.4 s","op":"between","event":"melee_hit","end":"sprint","end_where":{"on":false},"within_ms":400},
    {"enabled":false,"id":"knockback_bps","about":"Horizontal speed the server gave you (knockback, launches)","op":"value","event":"velocity","field":"bps"},
    {"enabled":false,"id":"ping","about":"Your ping at the end of the fight","op":"value","event":"fight_end","field":"ping"},
    {"enabled":false,"id":"fps","about":"Your frame rate at the end of the fight","op":"value","event":"fight_end","field":"fps"},
    {"enabled":false,"id":"near_dist","about":"Nearest player's distance, once a second","op":"bucket","event":"near","field":"dist","edges":[5,15,30,60]},
    {"enabled":false,"id":"near_dy","about":"Nearest player's height above you, once a second","op":"bucket","event":"near","field":"dy","edges":[-20,-5,5,20]},
    {"enabled":false,"id":"near_players","about":"Players within 32 blocks, once a second","op":"value","event":"near","field":"players"},
    {"enabled":false,"id":"subtitles","about":"Subtitles shown to you (headshot markers and others)","op":"count","event":"subtitle"}
  ]
}
